# Copy to .env.production on the server; never commit actual secrets.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
DATABASE_URL=postgresql://lifelikegame:REPLACE_WITH_RANDOM_HEX_PASSWORD@db:5432/lifelikegame
JWT_SECRET=
FRONTEND_URL=https://app.example.com
TIMEZONE=Asia/Kuala_Lumpur
# Explicit address(es) of your trusted ingress as seen by the API container.
# Never use *. Keep the API loopback binding and DB unpublished.
FORWARDED_ALLOW_IPS=127.0.0.1
AI_API_KEY=
AI_MODEL=
AI_DAILY_REQUEST_LIMIT=10
AI_REQUESTS_PER_MINUTE=3
LOGIN_REQUESTS_PER_MINUTE=10
SIGNUP_REQUESTS_PER_HOUR=10
